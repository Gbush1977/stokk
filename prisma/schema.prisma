generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String   @id @default(cuid())
  brand            String
  line             String
  shadeCode        String   @map("shade_code")
  sku              String   @unique
  idealStockLevel  Float    @map("ideal_stock_level")
  // Manual override so a manager can force a slow-moving shade onto the
  // active weekly order sheet even though its usage velocity would
  // otherwise hold it in the Pending Budget Review queue.
  budgetOverride   Boolean  @default(false) @map("budget_override")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  inventory         Inventory?
  consumptionHistory ConsumptionHistory[]

  @@unique([brand, line, shadeCode])
  @@map("products")
}

model Inventory {
  id              String    @id @default(cuid())
  productId       String    @unique @map("product_id")
  product         Product   @relation(fields: [productId], references: [id])
  // The "half-tube" split: a sealed, full box (fullQuantity) is tracked
  // distinctly from a partially-used backbar tube (partialQuantity, e.g. 0.5).
  fullQuantity    Int       @default(0) @map("full_quantity")
  partialQuantity Float     @default(0) @map("partial_quantity")
  lastScannedAt   DateTime? @map("last_scanned_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("inventory")
}

// Every consumption event (a color-tab scan logging tubes used on a client)
// lands here, dated and timestamped, so reorder velocity can be computed
// from real historical usage instead of a flat par-level threshold.
model ConsumptionHistory {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  quantityUsed Float    @map("quantity_used")
  scanMode     String   @map("scan_mode")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  @@map("consumption_history")
}
